rules_version = '2';

// Firebase Storage Security Rules for PIN-based Authentication
// Since we're not using Firebase Auth, we allow uploads based on file path validation
service firebase.storage {
  match /b/{bucket}/o {

    // Profile images - allow anyone to read, upload, and delete their own images
    match /profile_images/{fileName} {
      // Allow anyone to read profile images
      allow read: if true;

      // Allow uploads for profile images
      // Security: File size limit (5MB) and content type validation
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Allow deletion of profile images
      allow delete: if true;
    }

    // Bill images - allow anyone to read, upload, and delete
    match /bill_images/{fileName} {
      // Allow anyone to read bill images
      allow read: if true;

      // Allow uploads for bill images
      // Security: File size limit (10MB) and content type validation
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Allow deletion of bill images
      allow delete: if true;
    }

    // Offer banners - allow anyone to read, upload, and delete
    match /offer_banners/{fileName} {
      // Allow anyone to read offer banners
      allow read: if true;

      // Allow uploads for offer banners
      // Security: File size limit (5MB) and content type validation
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Allow deletion of offer banners
      allow delete: if true;
    }

    // Greeting images - allow anyone to read, upload, and delete
    match /greeting_images/{fileName} {
      // Allow anyone to read greeting images
      allow read: if true;

      // Allow uploads for greeting images
      // Security: File size limit (10MB) and content type validation
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Allow deletion of greeting images
      allow delete: if true;
    }

    // Product catalogs (PDF + cover image). Anyone can read. Only a branch
    // admin or the super admin can upload or delete (checked against their
    // Firestore users/{uid} record): PDFs up to 25 MB, covers up to 1 MB.
    // Admin check without Firestore where possible: PIN admins' sign-in
    // (adminPinSignIn) carries role "admin", and the super admin is known by
    // verified email. Only email-login branch admins need the Firestore
    // lookup, which requires Storage to have read access to Firestore.
    function isCatalogManager() {
      return request.auth != null
          && (request.auth.token.get('role', '') in ['admin', 'super_admin']
              || (request.auth.token.get('email', '') == 'aaijitechstudio@gmail.com'
                  && request.auth.token.get('email_verified', false) == true)
              || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
                  in ['admin', 'super_admin']);
    }
    match /catalogs/{catalogId}/{fileName} {
      allow read: if true;
      allow create, update: if isCatalogManager()
          && ((request.resource.contentType == 'application/pdf'
               && request.resource.size <= 25 * 1024 * 1024)
              || (request.resource.contentType.matches('image/(jpeg|png)')
               && request.resource.size <= 1024 * 1024));
      allow delete: if isCatalogManager();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
