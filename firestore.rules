rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // PIN-BASED AUTHENTICATION RULES
    // ============================================
    // Note: Since we're using phone+pin authentication instead of Firebase Auth,
    // we cannot use request.auth for authentication checks.
    // Admin operations are validated at the app level using SessionService.
    // These rules provide data validation and basic security.

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow anyone to read user documents
      // Needed for PIN-based auth to verify phone numbers and check user existence
      // PIN hashes are stored, not plain PINs, so this is safe
      allow read: if true;

      // Allow creating new user documents
      // Two cases:
      // 1) Full registration document (admin/verification flow) with role/points/tier
      // 2) Minimal self-profile doc where doc ID == phone (for legacy users that only exist by phone)
      allow create: if request.resource.data.phone != null
                    && (
                      (
                        request.resource.data.role != null
                        && request.resource.data.totalPoints != null
                        && request.resource.data.tier != null
                      )
                      || request.resource.data.phone == userId
                    );

      // Allow users to update their own document (profile).
      // Supports both:
      // - NEW docs: document ID == phone number
      // - LEGACY docs: document ID is a UID but phone is stored in resource.data.phone
      allow update: if request.resource.data.phone != null
                    && (
                      // New strategy: doc ID is the phone
                      request.resource.data.phone == userId
                      // Legacy strategy: doc ID is UID, phone stored in document data
                      || (resource.data.phone != null
                          && request.resource.data.phone == resource.data.phone)
                    );

      // Allow users to update notification preferences only
      allow update: if request.resource.data.phone != null
                    && (
                      request.resource.data.phone == userId
                      || (resource.data.phone != null
                          && request.resource.data.phone == resource.data.phone)
                    )
                    && request.resource.data.keys().hasAll(['notificationPreferences'])
                    && request.resource.data.notificationPreferences is map;

      // Allow admin updates (validated at app level).
      // Admin operations include: updating points, tier, profile info.
      // App validates admin status before making these requests.
      // Here we just require that a phone field is present.
      allow update: if request.resource.data.phone != null
                    && request.resource.data.keys().hasAll(['phone']);

      // Allow admin to delete users (validated at app level)
      allow delete: if true; // App-level validation ensures only admins can delete
    }

    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    match /products/{productId} {
      // All users (carpenters + admin) can read products
      allow read: if true;

      // Admin-only writes – validated at app level (PIN/session role)
      // Here we just enforce some basic field presence.
      allow create, update: if request.resource.data.name != null
                            && request.resource.data.price != null
                            && request.resource.data.mainCategory != null;

      // Admin can delete products (app-level admin check)
      allow delete: if true;
    }

    // ============================================
    // CARTS COLLECTION (per-user items subcollection)
    // ============================================
    match /carts/{userId}/items/{itemId} {
      // Carpenters can read/write their own cart items.
      // We don't have request.auth, so we trust the app to only use
      // the logged-in user's phone/userId as the {userId} path segment.
      allow read, write: if true;
    }

    // ============================================
    // ORDERS COLLECTION
    // ============================================
    match /orders/{orderId} {
      // Carpenters and admin can read orders
      allow read: if true;

      // Carpenters create orders when placing from cart
      allow create: if request.resource.data.userId != null
                    && request.resource.data.items != null
                    && request.resource.data.totalAmount != null
                    && request.resource.data.status != null;

      // Admin updates status (approved/rejected/etc.) – app enforces admin
      allow update, delete: if true;
    }

    // ============================================
    // USER POINTS COLLECTION
    // ============================================
    match /user_points/{pointsId} {
      // Anyone can read points (leaderboards, user profiles)
      allow read: if true;

      // Client may create user_points only during registration.
      // branchId on the new doc must match the user doc's branchId (or both null).
      allow create: if request.resource.data.userId == pointsId
                    && request.resource.data.keys().hasAll(['userId', 'totalPoints', 'tier']);

      // Client updates allowed only for the doc owner (userId == pointsId).
      // Points/tier changes driven by bill approval go through Cloud Functions
      // (Admin SDK bypasses rules), so we do NOT need to allow arbitrary updates here.
      allow update: if resource.data.userId == pointsId;

      // Deletes only via Admin SDK (Cloud Functions onUserDeleted)
      allow delete: if false;
    }

    // ============================================
    // POINTS HISTORY COLLECTION
    // ============================================
    match /points_history/{historyId} {
      // Anyone can read (user sees own history; app filters by userId)
      allow read: if true;

      // Client may create history for offer redemptions etc.
      // Bill-approval history is written by Cloud Function (Admin SDK).
      allow create: if request.resource.data.userId != null
                    && request.resource.data.points != null
                    && request.resource.data.reason != null;

      // Updates and deletes only via Admin SDK
      allow update, delete: if false;
    }

    // ============================================
    // BILLS COLLECTION
    // ============================================
    match /bills/{billId} {
      // Anyone can read bills (app filters by carpenterId / branchId)
      allow read: if true;

      // Carpenters submit new bills – must include branchId.
      allow create: if request.resource.data.carpenterId != null
                    && request.resource.data.carpenterPhone != null
                    && request.resource.data.amount != null
                    && request.resource.data.branchId != null
                    && request.resource.data.status == 'pending';

      // Admin updates bill status.
      // Immutable fields (carpenterId, amount, branchId) must not change.
      // The Cloud Function's Admin SDK write bypasses this rule, but the
      // client-side update (admin app) must satisfy it.
      allow update: if resource.data.carpenterId == request.resource.data.carpenterId
                    && resource.data.amount == request.resource.data.amount
                    && resource.data.branchId == request.resource.data.branchId
                    && (request.resource.data.status == 'approved'
                         || request.resource.data.status == 'rejected'
                         || request.resource.data.status == 'pending'
                         || request.resource.data.status == 'withdrawn');

      // Deletes allowed (admin can delete bills at app level)
      allow delete: if true;
    }

    // ============================================
    // OFFERS COLLECTION
    // ============================================
    match /offers/{offerId} {
      // Anyone can read offers (for display to carpenters)
      allow read: if true;

      // Allow admin to create offers (validated at app level)
      // Validation: Ensure required fields are present
      allow create: if request.resource.data.title != null
                    && request.resource.data.description != null
                    && request.resource.data.points != null
                    && request.resource.data.isActive != null;

      // Allow admin to update offers (validated at app level)
      // Validation: Ensure core fields remain consistent
      allow update: if request.resource.data.title != null
                    && request.resource.data.description != null
                    && request.resource.data.points != null
                    && request.resource.data.isActive != null;

      // Allow admin to delete offers (validated at app level)
      allow delete: if true; // App-level validation ensures only admins can delete
    }

    // ============================================
    // GREETINGS COLLECTION (admin broadcast messages)
    // ============================================
    match /greetings/{greetingId} {
      // All users can read greetings (for home screen banner)
      // Security: App-level filtering ensures carpenters only see active greetings
      allow read: if true;

      // Only admin can create greetings (validated at app level)
      // Validation: Ensure required fields are present
      allow create: if request.resource.data.message != null
                    && request.resource.data.createdAt != null
                    && request.resource.data.createdBy != null
                    && request.resource.data.active != null;

      // Only admin can update greetings (validated at app level)
      // Validation: Ensure core fields remain present
      allow update: if request.resource.data.message != null
                    && request.resource.data.active != null;

      // Only admin can delete greetings (validated at app level)
      allow delete: if true; // App-level validation ensures only admins can delete
    }

    // ============================================
    // OFFER REDEMPTIONS COLLECTION
    // ============================================
    match /offer_redemptions/{redemptionId} {
      // Allow reading redemptions (for user history, admin reports)
      allow read: if true;

      // Allow creating redemption records (when carpenter redeems offer)
      // Validation: Ensure required fields are present
      allow create: if request.resource.data.offerId != null
                    && request.resource.data.carpenterId != null
                    && request.resource.data.pointsUsed != null
                    && request.resource.data.status != null;

      // Allow admin to update/delete redemptions (validated at app level)
      allow update, delete: if true; // App-level validation ensures only admins can modify
    }

    // ============================================
    // DAILY SPINS COLLECTION
    // ============================================
    match /daily_spins/{spinId} {
      // Allow anyone to read spins
      // Security: App-level filtering ensures users only see their own spins
      allow read: if true;

      // Allow creating spin records (carpenters can spin)
      // Validation: Ensure userId field is present
      allow create: if request.resource.data.userId != null
                    && request.resource.data.timestamp != null;

      // Allow admin to update/delete spins (validated at app level)
      allow update, delete: if true; // App-level validation ensures only admins can modify
    }

    // ============================================
    // DAILY PRIZE WINNERS COLLECTION
    // ============================================
    match /daily_prize_winners/{winnerId} {
      // Anyone can read winners (for display on home screen, leaderboards)
      allow read: if true;

      // Allow admin to create winner records (from daily spin)
      // Validation: Ensure required fields are present
      allow create: if request.resource.data.carpenterId != null
                    && request.resource.data.carpenterName != null
                    && request.resource.data.date != null
                    && request.resource.data.timestamp != null;

      // Allow admin to update/delete winners (validated at app level)
      allow update: if request.resource.data.carpenterId != null
                    && request.resource.data.date != null;

      allow delete: if true; // App-level validation ensures only admins can delete
    }

    // ============================================
    // DAILY WINNERS COLLECTION (for easy lookup)
    // ============================================
    match /daily_winners/{date} {
      // Anyone can read daily winners
      allow read: if true;

      // Allow admin to create/update daily winner (one per day)
      // Validation: Ensure required fields are present
      allow write: if request.resource.data.carpenterId != null
                   && request.resource.data.carpenterName != null
                   && request.resource.data.date != null
                   && request.resource.data.timestamp != null;

      // Allow admin to delete (validated at app level)
      allow delete: if true; // App-level validation ensures only admins can delete
    }

    // ============================================
    // COUNTERS COLLECTION (for auto-incrementing IDs)
    // ============================================
    match /counters/{counterId} {
      // Allow reading counters
      allow read: if true;

      // Allow writing for user registration and other operations
      // This is needed for auto-incrementing user display IDs
      // Validation: Ensure counter value is a number
      // Supports both 'count' and 'lastId' field names
      allow write: if (request.resource.data.count != null
                       && request.resource.data.count is int)
                   || (request.resource.data.lastId != null
                       && request.resource.data.lastId is int);
    }

    // ============================================
    // PENDING USERS COLLECTION
    // ============================================
    match /pending_users/{phone} {
      // Allow reading pending users (for admin verification)
      allow read: if true;

      // Allow creating pending user documents (registration)
      // Validation: Ensure required fields are present
      allow create: if request.resource.data.phone != null
                    && request.resource.data.phone == phone
                    && request.resource.data.role != null;

      // Allow admin to update pending users (for approval/rejection)
      // App-level validation ensures only admins can update
      allow update: if request.resource.data.phone == phone;

      // Allow admin to delete pending users (validated at app level)
      allow delete: if true; // App-level validation ensures only admins can delete
    }

    // ============================================
    // OFFER REDEMPTIONS COLLECTION
    // ============================================
    match /offer_redemptions/{redemptionId} {
      // Allow reading redemptions
      allow read: if true;

      // Allow creating redemption records
      // Validation: Ensure required fields are present
      allow create: if request.resource.data.offerId != null
                    && request.resource.data.carpenterId != null
                    && request.resource.data.pointsUsed != null;

      // Allow admin to update/delete redemptions (validated at app level)
      allow update, delete: if true; // App-level validation ensures only admins can modify
    }

    // ============================================
    // NOTIFICATION QUEUE COLLECTION
    // ============================================
    match /notification_queue/{notificationId} {
      // Allow creating notification queue entries (for Cloud Functions to process)
      allow create: if request.resource.data.userId != null
                    && request.resource.data.fcmToken != null
                    && request.resource.data.type != null
                    && request.resource.data.title != null
                    && request.resource.data.body != null;

      // Allow reading for debugging/admin purposes
      allow read: if true;

      // Allow Cloud Functions to update status
      allow update: if request.resource.data.status != null;
    }

    // ============================================
    // NOTIFICATION LOGS COLLECTION
    // ============================================
    match /notification_logs/{logId} {
      // Allow creating notification logs (for analytics)
      allow create: if request.resource.data.type != null
                    && request.resource.data.title != null
                    && request.resource.data.body != null;

      // Allow reading individual documents and collection queries
      // This allows users to query their own notifications
      allow get: if true;
      allow list: if true;

      // Allow users to delete notifications
      // Users can delete:
      // 1. Their own notifications (userId exists)
      // 2. Broadcast notifications (isBroadcast == true) - these are visible to all users
      // Since this is PIN-based auth, we allow delete if:
      // - The notification has a userId field (user-specific notification)
      // - OR the notification is a broadcast (isBroadcast == true)
      // The app handles security by only showing relevant notifications to users
      // Note: Using 'hasAll' and 'get' to safely check for field existence
      allow delete: if ('userId' in resource.data && resource.data.userId != null)
                   || ('isBroadcast' in resource.data && resource.data.isBroadcast == true);
    }

    // ============================================
    // BRANCHES COLLECTION
    // ============================================
    match /branches/{branchId} {
      // All authenticated users can read branch list (for signup dropdown)
      allow read: if true;

      // Only super_admin / admin SDK creates/updates branches.
      // Client-side creates allowed only if the document has required fields.
      // Full security enforced at app level (only super_admin role can call BranchService.createBranch).
      allow create: if request.resource.data.name != null
                    && request.resource.data.shortName != null
                    && request.resource.data.isActive != null;

      allow update: if resource.data.name != null; // branch exists

      // Deletes disabled from client — use Admin SDK only
      allow delete: if false;
    }

    // ============================================
    // APP CONFIG (force / optional update metadata)
    // ============================================
    match /app_config/{docId} {
      // Public read — checked on splash before login (PIN auth has no request.auth)
      allow read: if true;
      // Writes only from Firebase Console / Admin SDK (not client apps)
      allow write: if false;
    }

    // ============================================
    // DEFAULT DENY RULE
    // ============================================
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
